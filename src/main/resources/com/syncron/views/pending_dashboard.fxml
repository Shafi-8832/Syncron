<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane style="-fx-background-color: #0F172A; -fx-font-family: 'Inter', sans-serif;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.syncron.controllers.PendingController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #1E293B; -fx-padding: 15 30; -fx-border-color: #334155; -fx-border-width: 0 0 1 0;">
            <Label text="KERNEL" style="-fx-font-family: 'Georgia', serif; -fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #38BDF8;"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Log Out" onAction="#handleLogout" style="-fx-background-color: transparent; -fx-border-color: #EF4444; -fx-text-fill: #EF4444; -fx-border-radius: 20; -fx-padding: 5 20; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="30" style="-fx-padding: 40 50;">

            <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #1E293B; -fx-border-color: #F59E0B; -fx-border-width: 1; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(245, 158, 11, 0.15), 20, 0, 0, 0);" VBox.vgrow="NEVER">
                <Label text="⏳ Verification Pending" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #F59E0B;"/>
                <Label text="Your request to join the department is under review. You will be granted full access to these resources once an Admin approves your account." wrapText="true" textAlignment="CENTER" style="-fx-font-size: 15px; -fx-text-fill: #94A3B8;"/>
            </VBox>

            <HBox spacing="30" VBox.vgrow="ALWAYS">

                <VBox spacing="15" HBox.hgrow="ALWAYS" style="-fx-background-color: #1E293B; -fx-border-color: #38BDF8; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 15, 0, 0, 5);">
                    <Label text="📚 Courses This Semester" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #38BDF8;"/>
                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                        <VBox fx:id="coursesListContainer" spacing="8"/>
                    </ScrollPane>
                </VBox>

                <VBox spacing="15" HBox.hgrow="ALWAYS" style="-fx-background-color: #1E293B; -fx-border-color: #F59E0B; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 15, 0, 0, 5);">
                    <Label text="👨‍🏫 Department Faculty" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #F59E0B;"/>
                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                        <VBox fx:id="teachersListContainer" spacing="8"/>
                    </ScrollPane>
                </VBox>

                <VBox spacing="15" HBox.hgrow="ALWAYS" style="-fx-background-color: #1E293B; -fx-border-color: #10B981; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 15, 0, 0, 5);">
                    <Label fx:id="studentCountLabel" text="🎓 Current Students" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #10B981;"/>
                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                        <VBox fx:id="studentsListContainer" spacing="8"/>
                    </ScrollPane>
                </VBox>

            </HBox>
        </VBox>
    </center>
</BorderPane>