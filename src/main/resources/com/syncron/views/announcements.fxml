<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.syncron.controllers.AnnouncementsController"
            fitToWidth="true"
            style="-fx-background: transparent; -fx-background-color: transparent;">

    <VBox spacing="20" style="-fx-padding: 30; -fx-background-color: transparent;">
        <HBox alignment="CENTER_LEFT">
            <Label text="Course Announcements Hub" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2C3E50; -fx-font-family: 'Georgia', serif;"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="createPostBtn" text="+ Create Course Announcement" onAction="#handleCreatePost" visible="false" managed="false"
                    style="-fx-background-color: #E67E22; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 15; -fx-background-radius: 6;"/>
        </HBox>

        <VBox fx:id="feedContainer" spacing="15" />
    </VBox>
</ScrollPane>