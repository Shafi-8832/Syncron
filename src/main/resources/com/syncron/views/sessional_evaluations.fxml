<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.ComboBox?>
<ScrollPane fitToWidth="true" styleClass="kernel-root" stylesheets="@../styles/kernel_warm.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.syncron.controllers.SessionalEvaluationsController">
    <VBox spacing="25.0" style="-fx-padding: 30 40 40 40;">

        <HBox alignment="CENTER_LEFT" spacing="15">
            <Button text="← Back" onAction="#goBack" style="-fx-background-color: transparent; -fx-text-fill: #A0522D; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0 10 0 0;" />
            <Label text="Create Assessment" style="-fx-font-family: 'Georgia', serif; -fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" />
        </HBox>

        <HBox spacing="15" alignment="CENTER_LEFT">
            <Button fx:id="offlineToggleBtn" text="Offline (Assignment)" styleClass="kernel-toggle-active" onAction="#setOfflineMode" />
            <Button fx:id="onlineToggleBtn" text="Online (Lab Test)" styleClass="kernel-toggle-inactive" onAction="#setOnlineMode" />
        </HBox>

        <VBox spacing="20" style="-fx-background-color: #FFFFFF; -fx-border-color: #E0D5C7; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(74,44,26,0.06), 10, 0, 0, 4);">
            <TextField fx:id="titleInput" promptText="Assessment Title" style="-fx-background-color: transparent; -fx-border-color: #ECF0F1; -fx-border-width: 0 0 2 0; -fx-font-family: 'Georgia', serif; -fx-font-size: 22px; -fx-text-fill: #2C3E50; -fx-padding: 10 5;" />

            <HBox spacing="30" style="-fx-padding: 10 0;">
                <VBox spacing="8">
                    <Label fx:id="dateLabel" text="Deadline Date" style="-fx-font-weight: bold; -fx-text-fill: #7F8C8D; -fx-font-size: 12px;" />
                    <DatePicker fx:id="datePicker" style="-fx-background-color: #F9F9F9; -fx-border-color: #E0E0E0; -fx-border-radius: 6;" />
                </VBox>

                <VBox spacing="8">
                    <Label fx:id="timeLabel" text="Due Time" style="-fx-font-weight: bold; -fx-text-fill: #7F8C8D; -fx-font-size: 12px;" />
                    <HBox spacing="5">
                        <ComboBox fx:id="startHour" promptText="HH" prefWidth="65" style="-fx-background-color: #F9F9F9; -fx-border-color: #E0E0E0; -fx-border-radius: 6;"/>
                        <ComboBox fx:id="startMin" promptText="MM" prefWidth="65" style="-fx-background-color: #F9F9F9; -fx-border-color: #E0E0E0; -fx-border-radius: 6;"/>
                        <ComboBox fx:id="startAmPm" promptText="AM/PM" prefWidth="85" style="-fx-background-color: #F9F9F9; -fx-border-color: #E0E0E0; -fx-border-radius: 6;"/>
                    </HBox>
                </VBox>

                <VBox fx:id="durationBox" spacing="8" visible="false" managed="false">
                    <Label text="Duration (Mins)" style="-fx-font-weight: bold; -fx-text-fill: #E74C3C; -fx-font-size: 12px;" />
                    <TextField fx:id="durationInput" promptText="e.g. 45" prefWidth="90" style="-fx-background-color: #F9F9F9; -fx-border-color: #E0E0E0; -fx-border-radius: 6;" />
                </VBox>

                <VBox spacing="8">
                    <Label text="Total Marks" style="-fx-font-weight: bold; -fx-text-fill: #7F8C8D; -fx-font-size: 12px;" />
                    <TextField fx:id="marksInput" promptText="100" prefWidth="80" style="-fx-background-color: #F9F9F9; -fx-border-color: #E0E0E0; -fx-border-radius: 6;" />
                </VBox>
            </HBox>


            <VBox fx:id="targetSectionContainer" spacing="10">
                <Label text="Target Sub-Sections" style="-fx-font-weight: bold; -fx-text-fill: #7F8C8D; -fx-font-size: 12px;" />
                <HBox fx:id="sectionBox" spacing="15">
                    <CheckBox text="A1" style="-fx-text-fill: #2C3E50;" />
                    <CheckBox text="A2" style="-fx-text-fill: #2C3E50;" />
                    <CheckBox text="B1" style="-fx-text-fill: #2C3E50;" />
                    <CheckBox text="B2" style="-fx-text-fill: #2C3E50;" />
                    <CheckBox text="C1" style="-fx-text-fill: #2C3E50;" />
                    <CheckBox text="C2" style="-fx-text-fill: #2C3E50;" />
                </HBox>
            </VBox>

            <VBox spacing="8" VBox.vgrow="ALWAYS">
                <Label text="Instructions / Syllabus" style="-fx-font-weight: bold; -fx-text-fill: #7F8C8D; -fx-font-size: 12px;" />
                <TextArea fx:id="descriptionInput" promptText="Write your instructions or syllabus here..." wrapText="true" prefRowCount="6" style="-fx-background-color: #F9F9F9; -fx-border-color: #E0E0E0; -fx-border-radius: 6; -fx-font-family: 'Inter', sans-serif;" />
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 15 0 0 0; -fx-border-color: #ECF0F1; -fx-border-width: 1 0 0 0;">
                <Button text="📎 Attach PDF" onAction="#handleAttachFile" style="-fx-background-color: #F0F3F4; -fx-text-fill: #2C3E50; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />
                <Label fx:id="fileNameLabel" text="No file selected" style="-fx-text-fill: #95A5A6; -fx-font-style: italic; -fx-font-size: 12px;" />
                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="cancelBtn" text="Cancel Edit" onAction="#handleCancel" visible="false" managed="false" style="-fx-background-color: transparent; -fx-text-fill: #7F8C8D; -fx-font-weight: bold; -fx-cursor: hand;" />
                <Button fx:id="publishBtn" text="Publish Assessment" onAction="#handlePublish" style="-fx-background-color: #D35400; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;" />
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>