<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.syncron.controllers.PublicProfileController">

    <VBox spacing="25" style="-fx-padding: 30 40; -fx-background-color: transparent;">

        <!-- Back button -->
        <HBox alignment="CENTER_LEFT">
            <Button text="← Back to Participants" onAction="#goBack"
                    style="-fx-background-color: transparent; -fx-text-fill: #A0522D; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0;"/>
        </HBox>

        <!-- Profile Card -->
        <VBox alignment="CENTER" spacing="18"
              style="-fx-background-color: #FFFFFF; -fx-border-color: #E0D5C7; -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 40; -fx-effect: dropshadow(three-pass-box, rgba(74,44,26,0.08), 15, 0, 0, 5);">

            <!-- Photo -->
            <Circle fx:id="profilePhoto" radius="52" fill="#EAECEE"/>

            <!-- Name + Role -->
            <HBox alignment="CENTER" spacing="12">
                <Label fx:id="nameLabel" text="Loading..." style="-fx-font-family: 'Georgia', serif; -fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
                <Label fx:id="roleBadge" text="ROLE" style="-fx-background-color: #D35400; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 4 14; -fx-background-radius: 14; -fx-font-size: 12px;"/>
            </HBox>

            <!-- Info Grid (dynamically populated by PublicProfileController) -->
            <VBox fx:id="infoContainer" spacing="10" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                <!-- Rows like "Student ID: 2105001", "Email: ...", "Section: A", etc. are added here by Java code -->
            </VBox>
        </VBox>

        <!-- Courses Section -->
        <VBox spacing="12">
            <Label fx:id="coursesSectionTitle" text="Courses Enrolled" style="-fx-font-family: 'Georgia', serif; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>

            <VBox fx:id="coursesContainer" spacing="8"
                  style="-fx-background-color: #FFFFFF; -fx-border-color: #E8E8E8; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 10, 0, 0, 3);">
                <Label text="Loading courses..." style="-fx-text-fill: #95A5A6; -fx-font-style: italic;"/>
            </VBox>
        </VBox>

    </VBox>
</ScrollPane>