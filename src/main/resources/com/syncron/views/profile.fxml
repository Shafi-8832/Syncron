<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane styleClass="kernel-root" stylesheets="@../styles/kernel_warm.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.syncron.controllers.ProfileController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="kernel-header">
            <Label text="KERNEL" style="-fx-font-family: 'Georgia', serif; -fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #8A3B2B; -fx-letter-spacing: 1px;" />
            <Circle radius="3.0" fill="#8C7A6B" />
            <Label text="CSE - BUET" style="-fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 14px; -fx-text-fill: #8C7A6B;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="🔔" styleClass="kernel-notification-btn" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" styleClass="profile-root">
            <content>
                <VBox alignment="TOP_CENTER" spacing="20">
                    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Dashboard" style="-fx-text-fill: #3498DB; -fx-cursor: hand; -fx-font-weight: bold;" onMouseClicked="#goBackToDashboard"/>
                        <Label text="/" style="-fx-text-fill: #7F8C8D;"/>
                        <Label text="Profile" style="-fx-text-fill: #7F8C8D;"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Log Out" style="-fx-background-color: transparent; -fx-text-fill: #E74C3C; -fx-border-color: #E74C3C; -fx-border-radius: 6; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 5 15;" onAction="#handleLogout"/>
                    </HBox>

                    <VBox alignment="TOP_CENTER" spacing="15" styleClass="profile-card">
                        <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>

                        <Circle fx:id="profilePhotoCircle" radius="48" fill="#EAECEE" styleClass="profile-photo-circle"/>

                        <HBox alignment="CENTER" spacing="10">
                            <Button mnemonicParsing="false" text="Upload Photo" styleClass="btn-outline-orange" onAction="#handleUploadPhoto"/>
                            <Button mnemonicParsing="false" text="Remove Photo" styleClass="btn-outline-orange" onAction="#handleRemovePhoto"/>
                        </HBox>

                        <HBox alignment="CENTER" spacing="12">
                            <Label fx:id="nameLabel" text="Loading Name..." styleClass="profile-name"/>
                            <Label fx:id="roleLabel" text="Role" styleClass="badge-orange"/>
                            <Label fx:id="sectionLabel" text="--" styleClass="badge-outline-gray"/>
                        </HBox>

                        <HBox fx:id="teacherInfoContainer" spacing="40" visible="false" managed="false" style="-fx-padding: 10 0;">
                            <VBox spacing="15" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT"><Label text="Nickname:" minWidth="120" style="-fx-text-fill: #7F8C8D; -fx-font-weight: bold;"/><TextField fx:id="nicknameField" promptText="Set a display nickname..." styleClass="editable-profile-field" HBox.hgrow="ALWAYS"/></HBox>
                                <HBox alignment="CENTER_LEFT"><Label text="Bio:" minWidth="120" style="-fx-text-fill: #7F8C8D; -fx-font-weight: bold;"/><TextField fx:id="bioField" promptText="Add a bio..." styleClass="editable-profile-field" HBox.hgrow="ALWAYS"/></HBox>
                                <HBox alignment="CENTER_LEFT"><Label text="Teacher ID:" minWidth="120" style="-fx-text-fill: #7F8C8D; -fx-font-weight: bold;"/><Label fx:id="teacherIdLabel" text="--"/></HBox>
                                <HBox alignment="CENTER_LEFT"><Label text="Contact No:" minWidth="120" style="-fx-text-fill: #7F8C8D; -fx-font-weight: bold;"/><TextField fx:id="contactField" promptText="Add contact number..." styleClass="editable-profile-field" HBox.hgrow="ALWAYS"/></HBox>
                                <HBox style="-fx-padding: 20 0 0 0;">
                                    <Button mnemonicParsing="false" text="Change Password" styleClass="btn-outline-orange" onAction="#handleShowPasswordForm"/>
                                </HBox>
                            </VBox>
                            <VBox spacing="15" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT"><Label text="GitHub:" minWidth="100" style="-fx-text-fill: #7F8C8D; -fx-font-weight: bold;"/><TextField fx:id="githubField" promptText="github.com/..." styleClass="editable-profile-field" HBox.hgrow="ALWAYS"/></HBox>
                                <HBox alignment="CENTER_LEFT"><Label text="LinkedIn:" minWidth="100" style="-fx-text-fill: #7F8C8D; -fx-font-weight: bold;"/><TextField fx:id="linkedinField" promptText="linkedin.com/in/..." styleClass="editable-profile-field" HBox.hgrow="ALWAYS"/></HBox>
                                <HBox alignment="CENTER_LEFT"><Label text="FB Link:" minWidth="100" style="-fx-text-fill: #7F8C8D; -fx-font-weight: bold;"/><TextField fx:id="fbField" promptText="facebook.com/..." styleClass="editable-profile-field" HBox.hgrow="ALWAYS"/></HBox>
                                <HBox alignment="CENTER_LEFT"><Label text="Room No:" minWidth="100" style="-fx-text-fill: #7F8C8D; -fx-font-weight: bold;"/><TextField fx:id="roomField" promptText="e.g., Room 402" styleClass="editable-profile-field" HBox.hgrow="ALWAYS"/></HBox>
                                <HBox alignment="CENTER_LEFT"><Label text="Email:" minWidth="100" style="-fx-text-fill: #7F8C8D; -fx-font-weight: bold;"/><TextField fx:id="teacherEmailLabel" text="--" editable="false" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-text-fill: #2C3E50; -fx-padding: 0;"/></HBox>
                            </VBox>
                        </HBox>

                        <VBox fx:id="studentInfoContainer" spacing="15" visible="false" managed="false" alignment="CENTER_LEFT" style="-fx-padding: 10 0;">
                            <HBox alignment="CENTER_LEFT"><Label text="Nickname:" minWidth="120" style="-fx-text-fill: #7F8C8D; -fx-font-weight: bold;"/><TextField fx:id="studentNicknameField" promptText="Set a display nickname..." styleClass="editable-profile-field" HBox.hgrow="ALWAYS"/></HBox>
                            <HBox alignment="CENTER_LEFT"><Label text="Bio:" minWidth="120" style="-fx-text-fill: #7F8C8D; -fx-font-weight: bold;"/><TextField fx:id="studentBioField" promptText="Add a bio..." styleClass="editable-profile-field" HBox.hgrow="ALWAYS"/></HBox>
                            <HBox alignment="CENTER_LEFT"><Label text="Student ID:" minWidth="120" style="-fx-text-fill: #7F8C8D; -fx-font-weight: bold;"/><Label fx:id="studentIdLabel" text="--"/></HBox>
                            <HBox alignment="CENTER_LEFT"><Label text="Email Address:" minWidth="120" style="-fx-text-fill: #7F8C8D; -fx-font-weight: bold;"/><TextField fx:id="studentEmailLabel" text="--" editable="false" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-text-fill: #2C3E50; -fx-padding: 0;"/></HBox>
                            <Region style="-fx-border-color: #E0E0E0; -fx-border-width: 0 0 1 0; -fx-border-style: solid;"/>
                            <HBox alignment="CENTER_LEFT"><Label text="GitHub:" minWidth="120" style="-fx-text-fill: #7F8C8D; -fx-font-weight: bold;"/><TextField fx:id="studentGithubField" promptText="github.com/..." styleClass="editable-profile-field" HBox.hgrow="ALWAYS"/></HBox>
                            <HBox alignment="CENTER_LEFT"><Label text="LinkedIn:" minWidth="120" style="-fx-text-fill: #7F8C8D; -fx-font-weight: bold;"/><TextField fx:id="studentLinkedinField" promptText="linkedin.com/in/..." styleClass="editable-profile-field" HBox.hgrow="ALWAYS"/></HBox>

                            <HBox style="-fx-padding: 10 0 10 0;">
                                <Button mnemonicParsing="false" text="Change Password" styleClass="btn-outline-orange" onAction="#handleShowPasswordForm"/>
                            </HBox>
                        </VBox>

                        <VBox fx:id="passwordFormBox" spacing="10" maxWidth="400" visible="false" managed="false" styleClass="profile-card" alignment="CENTER_LEFT">
                            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                            <Label text="Change Password" styleClass="profile-section-title"/>
                            <PasswordField fx:id="currentPasswordField" promptText="Current Password"/>
                            <PasswordField fx:id="newPasswordField" promptText="New Password"/>
                            <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password"/>
                            <Label fx:id="passwordErrorLabel" textFill="#E74C3C" style="-fx-font-weight: bold;"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Button mnemonicParsing="false" text="Save" styleClass="btn-outline-orange" style="-fx-background-color: #E67E22; -fx-text-fill: white;" onAction="#handleChangePassword"/>
                                <Button mnemonicParsing="false" text="Cancel" styleClass="btn-outline-orange" style="-fx-border-color: transparent; -fx-text-fill: #7F8C8D;" onAction="#handleCancelPasswordChange"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10 0 5 0;">
                        <Button text="Save Changes" onAction="#handleSaveChanges"
                                style="-fx-background-color: #27AE60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 30; -fx-background-radius: 25; -fx-cursor: hand; -fx-font-size: 14px; -fx-effect: dropshadow(three-pass-box, rgba(39, 174, 96, 0.3), 8, 0, 0, 2);"/>
                        <Label fx:id="saveStatusLabel" text="" visible="false" managed="false"/>
                    </HBox>

                    <VBox fx:id="studentHistoryBox" spacing="10">
                        <Label text="Course Enrollment History" styleClass="profile-section-title"/>
                        <VBox spacing="20" styleClass="profile-card">
                            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                            <Label text="Level - I Term - II" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #2C3E50;"/>
                        </VBox>
                    </VBox>

                    <VBox fx:id="teacherAssignedBox" spacing="10">
                        <Label text="Course Assigned" styleClass="profile-section-title"/>
                        <VBox spacing="20" styleClass="profile-card">
                            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                            <Label text="Current Semester" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #2C3E50;"/>
                        </VBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>