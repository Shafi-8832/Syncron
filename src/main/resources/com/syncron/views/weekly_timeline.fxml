<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.syncron.controllers.WeeklyTimelineController"
            fitToWidth="true"
            style="-fx-background: transparent; -fx-background-color: transparent;">

    <VBox spacing="15" style="-fx-padding: 30; -fx-background-color: transparent;">
        <HBox alignment="CENTER_LEFT">
            <Label text="Weekly Timeline" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #ECEFF1;"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="addWeekBtn" text="+ Add New Week" onAction="#handleAddWeek" visible="false" managed="false"
                    style="-fx-background-color: #D35400; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 15; -fx-background-radius: 6;"/>
        </HBox>

        <VBox fx:id="timelineContainer" spacing="12"/>
    </VBox>

</ScrollPane>