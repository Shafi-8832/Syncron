<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<ScrollPane fitToWidth="true" styleClass="kernel-root" stylesheets="@../styles/kernel_warm.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.syncron.controllers.ViewProfileController">
    <VBox spacing="25" style="-fx-padding: 30 40;">

        <HBox alignment="CENTER_LEFT">
            <Button text="← Back to Assessment" onAction="#goBack" style="-fx-background-color: transparent; -fx-text-fill: #A0522D; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0;" />
        </HBox>

        <VBox alignment="CENTER" spacing="15" style="-fx-background-color: #FFFFFF; -fx-border-color: #E0D5C7; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 50; -fx-effect: dropshadow(three-pass-box, rgba(74,44,26,0.06), 10, 0, 0, 4); -fx-max-width: 600; -fx-alignment: center;">

            <Circle fx:id="profileImage" radius="50" fill="#EAECEE" />

            <VBox alignment="CENTER" spacing="5">
                <Label fx:id="nameLabel" text="Loading Name..." style="-fx-font-family: 'Georgia', serif; -fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" />
                <Label fx:id="roleTag" text="ROLE" style="-fx-background-color: #D35400; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 4 12; -fx-background-radius: 12; -fx-font-size: 12px;" />
            </VBox>

            <VBox spacing="10" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                <Label fx:id="emailLabel" text="Email: --" style="-fx-text-fill: #34495E; -fx-font-size: 15px;" />
                <Label fx:id="deptLabel" text="Department of Computer Science &amp; Engineering" style="-fx-text-fill: #7F8C8D; -fx-font-size: 14px;" />
                <Label text="Bangladesh University of Engineering &amp; Technology" style="-fx-text-fill: #95A5A6; -fx-font-size: 13px;" />
            </VBox>

        </VBox>
    </VBox>
</ScrollPane>